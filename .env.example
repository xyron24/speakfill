# Copy to .env for local overrides (NEVER commit .env with real keys)
APP_NAME=speakfill
APP_BASE_URL=http://localhost:8080

# Production (server .env only): public domain + prod Caddy profile with TLS.
# Local dev leaves these empty and uses Caddyfile on :8080.
DOMAIN=
CADDYFILE=

POSTGRES_USER=speakfill
POSTGRES_PASSWORD=speakfill
POSTGRES_DB=speakfill
DATABASE_URL=postgresql+psycopg://speakfill:speakfill@db:5432/speakfill

DATA_DIR=/data

# smallest.ai voice APIs (VOICE_PROVIDER=stub for offline tests)
VOICE_PROVIDER=smallest
SMALLEST_API_KEY=
SMALLEST_STT_MODEL=pulse
SMALLEST_TTS_MODEL=lightning_v3.1_pro
SMALLEST_VOICE_EN=meher
SMALLEST_VOICE_HI=meher

# LLM provider behind a thin adapter ("stub" = scripted responses for tests)
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
